# Copy to .streamlit/secrets.toml for local runs, or paste into
# Streamlit Community Cloud → your app → Settings → Secrets when deployed.
# Never commit the real file (it's in .gitignore).

# --- OpenAI -----------------------------------------------------------------
OPENAI_API_KEY = "sk-..."
OPENAI_MODEL = "gpt-5-nano"          # any chat model that supports JSON mode
# OPENAI_REASONING_EFFORT = "minimal" # optional; only for reasoning models that accept it
PRICE_INPUT_PER_M = 0.05             # USD per 1M input tokens  — check OpenAI's pricing page
PRICE_OUTPUT_PER_M = 0.40            # USD per 1M output tokens — check OpenAI's pricing page
MONTHLY_BUDGET_USD = 2.0             # hard cap enforced by the app

# --- Who may open the app ---------------------------------------------------
ALLOWED_EMAILS = ["utathya.course@gmail.com"]

# --- Where progress is saved (a separate private repo; see README) -----------
GITHUB_TOKEN = "github_pat_..."      # fine-grained token: that one repo, Contents read & write
GITHUB_REPO = "your-username/dl-coach-data"
GITHUB_BRANCH = "main"
GITHUB_STATE_PATH = "data/state.json"

TIMEZONE = "Asia/Kolkata"

# --- Google sign-in (Streamlit's built-in OIDC login) -------------------------
[auth]
redirect_uri = "https://YOUR-APP.streamlit.app/oauth2callback"
cookie_secret = "a-long-random-string"   # e.g. python -c "import secrets; print(secrets.token_hex(32))"
client_id = "....apps.googleusercontent.com"
client_secret = "..."
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

# --- Local development only -------------------------------------------------
# DEV_MODE_NO_AUTH = true   # skips sign-in when there is no [auth] section. Never set this when deployed.
